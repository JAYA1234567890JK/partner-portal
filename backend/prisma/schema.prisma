generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  CUSTOMER
  PARTNER
  ADMIN
}

enum PropertyApprovalStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  UNDER_REVIEW
  MAINTENANCE
  INACTIVE
}

enum RoomVerificationStatus {
  PENDING
  UNDER_REVIEW
  VERIFIED
  REJECTED
}

model User {
  id                 String     @id @default(cuid())
  fullName           String
  email              String     @unique
  phone              String?
  passwordHash       String
  role               UserRole   @default(CUSTOMER)
  isActive           Boolean    @default(true)
  adminId            String?    @unique
  partner            Partner?
  reviewedProperties Property[] @relation("PropertyReviewer")
  createdAt          DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime   @updatedAt @db.Timestamptz(6)

  @@index([role, isActive])
}

model Partner {
  id            String     @id @default(cuid())
  userId        String     @unique
  businessName  String
  contactName   String
  businessEmail String
  businessPhone String
  businessType  String?
  city          String?
  state         String?
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  properties    Property[]
  createdAt     DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime   @updatedAt @db.Timestamptz(6)

  @@index([businessEmail])
}

model Property {
  id                   String                 @id @default(cuid())
  partnerId            String
  name                 String
  propertyType         String
  description          String?
  address              String
  landmark             String?
  city                 String
  state                String
  pincode              String
  latitude             Float?
  longitude            Float?
  approvalStatus       PropertyApprovalStatus @default(DRAFT)
  applicationReference String?                @unique
  submittedAt          DateTime?              @db.Timestamptz(6)
  onboardingData       Json?
  reviewNote           String?
  reviewedAt           DateTime?              @db.Timestamptz(6)
  reviewedById         String?
  partner              Partner                @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  reviewer             User?                  @relation("PropertyReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  images               PropertyImage[]
  rooms                Room[]
  createdAt            DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime               @updatedAt @db.Timestamptz(6)

  @@index([partnerId, approvalStatus])
  @@index([city, state])
  @@index([reviewedById])
}

model PropertyImage {
  id           String   @id @default(cuid())
  propertyId   String
  category     String
  imageUrl     String
  isCover      Boolean  @default(false)
  sortOrder    Int      @default(0)
  imageDetails Json?
  storagePath  String?  @unique
  property     Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  @@index([propertyId, sortOrder])
}

model Room {
  id                 String                 @id @default(cuid())
  propertyId         String
  roomNumber         String
  roomName           String
  roomType           String
  capacity           Int
  bedCount           Int
  description        String?
  roomDetails        Json?
  status             RoomStatus             @default(UNDER_REVIEW)
  verificationStatus RoomVerificationStatus @default(PENDING)
  property           Property               @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  images             RoomImage[]
  hourlyPricing      HourlyPricing[]
  createdAt          DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime               @updatedAt @db.Timestamptz(6)

  @@unique([propertyId, roomNumber])
  @@index([propertyId, status])
  @@index([verificationStatus])
}

model RoomImage {
  id           String   @id @default(cuid())
  roomId       String
  imageUrl     String
  category     String   @default("Room")
  sortOrder    Int      @default(0)
  isCover      Boolean  @default(false)
  imageDetails Json?
  storagePath  String?  @unique
  room         Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  @@index([roomId, sortOrder])
}

model HourlyPricing {
  id            String   @id @default(cuid())
  roomId        String
  durationHours Int
  price         Decimal  @db.Decimal(10, 2)
  isActive      Boolean  @default(true)
  room          Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @db.Timestamptz(6)

  @@unique([roomId, durationHours])
  @@index([isActive, durationHours])
}
